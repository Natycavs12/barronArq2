---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <!-- Hero de contacto -->
  <section class="relative w-full h-[50vh] bg-cover bg-center flex items-center justify-center"
           style="background-image: url('/assets/backgrounds/contacto.webp');">
    <div class="absolute inset-0 bg-black/50"></div>

    <div class="relative z-10 text-center px-6">
      <h1 class="text-white text-5xl md:text-6xl font-bold drop-shadow-lg">
        Contacto
      </h1>
      <p class="mt-4 text-lg md:text-2xl text-white drop-shadow-sm">
        Hablemos sobre tu proyecto de arquitectura
      </p>
    </div>
  </section>

  <!-- Formulario de contacto -->
  <section class="py-16 px-6 md:px-12 max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-center">Envíanos un mensaje</h2>
    
    <form class="space-y-6" action="https://formspree.io/f/tu_form_id" method="POST">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Nombre</label>
        <input type="text" id="name" name="name" required
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm p-3 focus:border-black focus:ring-black" 
               placeholder="Tu nombre" />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
        <input type="email" id="email" name="email" required
               class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm p-3 focus:border-black focus:ring-black"
               placeholder="tunombre@mail.com" />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700">Mensaje</label>
        <textarea id="message" name="message" rows="5" required
                  class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm p-3 focus:border-black focus:ring-black"
                  placeholder="Escribe tu consulta..."></textarea>
      </div>

      <button type="submit"
              class="w-full bg-black text-white font-semibold py-3 px-6 rounded-md hover:bg-gray-800 transition">
        Enviar
      </button>
    </form>

    <!-- Información de contacto adicional -->
    <!-- <div class="mt-12 text-center text-gray-700 space-y-2">
      <p>📞 +54 9 011 5116 8886</p>
      <p>✉️ info@barronarq.com</p>
    </div> -->
  </section>

  <!-- Carrusel opcional de proyectos destacados -->
  <section class="w-full py-16 bg-gray-100">
    <h2 class="text-3xl font-bold text-center mb-8">Proyectos destacados</h2>

    <div class="max-w-6xl mx-auto">
      <!-- Reutilizamos el carrusel del layout -->
      <slot name="carousel" />
    </div>
  </section>

  <script>
    function onSubmit() {
    //   window.location.href = "https://wa.me/549115118886";
        return false; // Evita el envío del formulario tradicional
    }
  </script>
</MainLayout>
