---
import MainLayout from "../layouts/MainLayout.astro";
import Carousel from "../components/Carousel.jsx";
import Card from "../components/Card.astro";

// Importación de las imágenes para el carrusel
import slide1 from "../assets/carousel/1.png";
import slide2 from "../assets/carousel/2.JPG";
import slide3 from "../assets/carousel/3.PNG";
import slide4 from "../assets/carousel/4.jpg";
import slide5 from "../assets/carousel/5.jpg";
import slide6 from "../assets/carousel/6.jpg";

const homeImages = [slide1, slide2, slide3, slide4, slide5, slide6];
---
<MainLayout>

  <!-- Hero Section con Carrusel y contenido principal -->
  <section class="hero relative w-full h-screen overflow-hidden">

    <!-- Carrusel de fondo -->
    <div class="w-full mx-auto absolute inset-0 z-0">
      <Carousel client:load images={homeImages} />
    </div>

    <!-- Contenido principal superpuesto -->
    <section
      class="principal relative z-20 flex flex-col justify-center items-center text-center text-white bg-black/40 px-6 h-full"
    >
      <div class="ppal_superior max-w-3xl">
        <h2 class="text-3xl md:text-5xl font-bold mb-4 text-shadow-strong">
          ARQUITECTURA Y CONSTRUCCIÓN
        </h2>
        <h3 class="text-lg md:text-xl mb-6 drop-shadow-md">
          Diseñamos espacios arquitectónicos a medida, combinando funcionalidad,
          identidad y una estética cuidada.
        </h3>
        <button
          type="button"
          onclick="irawp()"
          class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-lg transition"
          >CONTÁCTANOS</button
        >
      </div>

      <div class="ppal_inferior mt-10 bg-black/60 p-6 rounded-lg max-w-3xl">
        <h2 class="text-2xl font-semibold mb-2">
          PROYECTO – DIRECCION – CONSTRUCCION
        </h2>
        <p class="text-sm md:text-base">
          Diseñamos viviendas y espacios comerciales a medida, uniendo
          funcionalidad, identidad y estética. Acompañamos cada etapa del
          proyecto para transformar ideas en obras duraderas y bien pensadas.
        </p>
      </div>
    </section>
  </section>

  <hr class="my-12 border-gray-300" />

  <section class="medium relative text-center px-6 mt-24 z-40">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
    <Card>
      <h4 class="text-xl font-semibold mb-2">Nuestra Visión</h4>
      <p class="mb-6">
        “Generar Arquitectura que transforme ideas en calidad de vida.”
      </p>
    </Card>

    <Card>
      <h4 class="text-xl font-semibold mb-2">Nuestra Misión</h4>
      <p class="mb-6">
        “Diseñar espacios funcionales, estéticos y duraderos que mejoren la vida
        y las actividades de las personas.”
      </p>
    </Card>

    <Card>
      <h4 class="text-xl font-semibold mb-2">Nuestros Valores</h4>
      <p class="mb-6">
        “Escuchar, diseñar con calidad y crear espacios que mejoren la vida.”
      </p>
    </Card>
  </div>
</section>

  <hr class="my-12 border-gray-300" />
</MainLayout>
