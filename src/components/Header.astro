---
import logo_header from "../../public/assets/logo.webp";
---

<header
  class="flex justify-between items-center w-full text-white bg-black/70 px-4 relative z-50"
>
  <div id="navbar">
    <!-- Logo -->
    <div id="logo">
      <a href="/" target="_blank" rel="noopener noreferrer">
        <img
          src={logo_header.src}
          alt="Logo BarronArq"
          id="logo"
          class="h-12 w-auto"
        />
      </a>

      <!-- Botón menú hamburguesa -->
      <button
        id="menu-btn"
        class="md:hidden focus:outline-none"
        aria-label="Abrir menú"
      >
        <svg
          class="w-8 h-8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Menú principal (desktop) -->
    <nav id="navigation" class="hidden md:flex space-x-6">
      <ul>
        <li><a href="/">INICIO</a></li>
        <li><a href="/about">QUIENES SOMOS</a></li>
        <li><a href="/residencials">OBRAS RESIDENCIALES</a></li>
        <li><a href="/commercials">OBRAS COMERCIALES</a></li>
        <li>
          <a href="/services">OTROS SERVICIOS</a><li>
            <li><a href="/contact">CONTACTO</a></li>
          </li>
        </li>
      </ul>
    </nav>

    <!-- Menú lateral móvil -->
    <div
      id="mobile-menu"
      class="fixed top-0 right-0 w-2/3 h-full bg-black text-white flex flex-col items-start p-6 space-y-4 transform translate-x-full transition-transform duration-300 ease-in-out z-40"
    >
      <button id="close-menu" class="self-end mb-4">
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <a href="/" class="w-full border-b border-gray-700 pb-2">INICIO</a>
      <a href="/about" class="w-full border-b border-gray-700 pb-2"
        >QUIÉNES SOMOS</a
      >
      <a
        href="/projects/residenciales"
        class="w-full border-b border-gray-700 pb-2">OBRAS RESIDENCIALES</a
      >
      <a
        href="/projects/comerciales"
        class="w-full border-b border-gray-700 pb-2">OBRAS COMERCIALES</a
      >
      <a href="/services" class="w-full border-b border-gray-700 pb-2"
        >OTROS SERVICIOS</a
      >
      <a href="/contact" class="w-full border-b border-gray-700 pb-2"
        >CONTACTO</a
      >
    </div>

    <script>
      const menuBtn = document.getElementById("menu-btn");
      const closeBtn = document.getElementById("close-menu");
      const mobileMenu = document.getElementById("mobile-menu");

      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.remove("translate-x-full");
        mobileMenu.classList.add("translate-x-0");
      });

      closeBtn.addEventListener("click", () => {
        mobileMenu.classList.remove("translate-x-0");
        mobileMenu.classList.add("translate-x-full");
      });
    </script>
  </div>
</header>
