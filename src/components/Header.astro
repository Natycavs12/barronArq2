---
import logo_header from "../../public/assets/logo.webp";
---

<header
  class="flex justify-around items-center w-full text-white bg-black/80 px-4 fixed top-0 left-0 z-50 h-24"
>
  <!-- <div id="navbar" class="flex items-center justify-between w-full"> -->
  <!-- <div class="flex items-center justify-between w-full"> -->

  <!-- Logo -->
  <div id="logo" class="flex items-center gap-4">
    <a href="/" target="_blank" rel="noopener noreferrer">
      <img
        src={logo_header.src}
        alt="Logo BarronArq"
        id="img-logo"
        class="h-[10vh] max-h-20 w-auto object-contain"
      />
    </a>
  </div>

  <!-- Botón menú hamburguesa -->
  <button
    id="menu-btn"
    class="block md:hidden focus:outline-none"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg
      class="w-8 h-8"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Menú principal (desktop) -->
  <nav id="navigation" class="hidden md:flex items-center space-x-6">
    <ul class="flex items-center gap-6">
      <li><a href="/" class="hover:underline">INICIO </a></li>
      <li><a href="/about" class="hover:underline">QUIENES SOMOS </a></li>
      <li>
        <a href="/residencials" class="hover:underline">OBRAS RESIDENCIALES </a>
      </li>
      <li>
        <a href="/commercials" class="hover:underline">OBRAS COMERCIALES </a>
      </li>
      <li><a href="/services" class="hover:underline">OTROS SERVICIOS </a></li>
      <li><a href="/contact" class="hover:underline">CONTACTO </a></li>
    </ul>
  </nav>
  <!-- </div> -->

  <!-- Menú lateral móvil -->
  <div
    id="mobile-menu"
    class="fixed top-0 right-0 w-2/3 h-full bg-black text-white flex flex-col items-start p-6 space-y-4 transform translate-x-full transition-transform duration-300 ease-in-out z-50 md:hidden"
  >
    <button
      id="close-menu"
      class="self-end mb-4 focus:outline-none"
      aria-label="Cerrar menú"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <a href="/" class="w-full border-b border-gray-700 pb-2">INICIO</a>
    <a href="/about" class="w-full border-b border-gray-700 pb-2"
      >QUIÉNES SOMOS</a
    >
    <a href="/residencials" class="w-full border-b border-gray-700 pb-2"
      >OBRAS RESIDENCIALES</a
    >
    <a href="/commercials" class="w-full border-b border-gray-700 pb-2"
      >OBRAS COMERCIALES</a
    >
    <a href="/services" class="w-full border-b border-gray-700 pb-2"
      >OTROS SERVICIOS</a
    >
    <a href="/contact" class="w-full border-b border-gray-700 pb-2">CONTACTO</a>
  </div>
</header>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuBtn = document.getElementById("menu-btn");
    const closeBtn = document.getElementById("close-menu");
    const mobileMenu = document.getElementById("mobile-menu");
    const root = document.documentElement;

    if (!menuBtn || !mobileMenu) return;

    const openMenu = () => {
      mobileMenu.classList.remove("translate-x-full");
      mobileMenu.classList.add("translate-x-0");
      mobileMenu.setAttribute("aria-hidden", "false");
      menuBtn.setAttribute("aria-expanded", "true");
      root.classList.add("overflow-hidden");
    };

    const closeMenu = () => {
      mobileMenu.classList.remove("translate-x-0");
      mobileMenu.classList.add("translate-x-full");
      mobileMenu.setAttribute("aria-hidden", "true");
      menuBtn.setAttribute("aria-expanded", "false");
      root.classList.remove("overflow-hidden");
    };

    menuBtn.addEventListener("click", openMenu);
    closeBtn?.addEventListener("click", closeMenu);

    mobileMenu.addEventListener("click", (e) => {
      if (e.target === mobileMenu) closeMenu();
    });

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        mobileMenu.getAttribute("aria-hidden") === "false"
      ) {
        closeMenu();
      }
    });
  });
</script>
